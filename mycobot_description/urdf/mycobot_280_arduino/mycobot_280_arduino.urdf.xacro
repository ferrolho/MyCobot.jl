<?xml version="1.0"?>
<!-- myCobot 280 for Arduino: the source of the robot description. tools/gen_robot.py expands it
     (xacro) into mycobot_280_arduino.urdf (meshes: package:// .dae) and the Control page's copy
     (website/public/robot/, meshes: .glb). Edit this file and config/mycobot_280_arduino/*.yaml,
     not the generated URDFs.

     Kinematics and meshes: Elephant Robotics' mycobot_280_arduino.urdf (mycobot_ros), with the
     flange turned 45° about its axis (2025-02-16). Elephant's other 280 URDFs have the same lengths.
     Joint limits: config/mycobot_280_arduino/joint_limits.yaml. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_280_arduino">

  <xacro:arg name="mesh_uri" default="package://mycobot_description/urdf/mycobot_280_arduino/" />
  <xacro:arg name="mesh_ext" default="dae" />
  <xacro:property name="limits" value="${xacro.load_yaml('../../config/mycobot_280_arduino/joint_limits.yaml')['joint_limits']}" />

  <!-- A link with the same mesh for visual and collision. -->
  <xacro:macro name="mesh_link" params="name mesh xyz rpy scale:=''">
    <link name="${name}">
      <visual>
        <geometry>
          <xacro:if value="${scale != ''}"><mesh filename="$(arg mesh_uri)${mesh}.$(arg mesh_ext)" scale="${scale}" /></xacro:if>
          <xacro:unless value="${scale != ''}"><mesh filename="$(arg mesh_uri)${mesh}.$(arg mesh_ext)" /></xacro:unless>
        </geometry>
        <origin xyz="${xyz}" rpy="${rpy}" />
      </visual>
      <collision>
        <geometry>
          <xacro:if value="${scale != ''}"><mesh filename="$(arg mesh_uri)${mesh}.$(arg mesh_ext)" scale="${scale}" /></xacro:if>
          <xacro:unless value="${scale != ''}"><mesh filename="$(arg mesh_uri)${mesh}.$(arg mesh_ext)" /></xacro:unless>
        </geometry>
        <origin xyz="${xyz}" rpy="${rpy}" />
      </collision>
    </link>
  </xacro:macro>

  <!-- A revolute joint about its z axis, with the limits from joint_limits.yaml. -->
  <xacro:macro name="arm_joint" params="name parent child xyz rpy">
    <xacro:property name="l" value="${limits[name]}" />
    <joint name="${name}" type="revolute">
      <axis xyz="0 0 1" />
      <limit lower="${l['min_position']}" upper="${l['max_position']}" velocity="${l['max_velocity']}" effort="${l['max_effort']}" />
      <parent link="${parent}" />
      <child link="${child}" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>
  </xacro:macro>

  <xacro:mesh_link name="g_base" mesh="G_base" xyz="-0.01 0 -0.032" rpy="0 0 1.5708" scale="0.001 0.001 0.001" />
  <xacro:mesh_link name="joint1" mesh="joint1" xyz="0 0 0" rpy="0 0 -3.14159" scale="0.001 0.001 0.001" />
  <xacro:mesh_link name="joint2" mesh="joint2" xyz="0 0 -0.06096" rpy="0 0 -1.5708" />
  <xacro:mesh_link name="joint3" mesh="joint3" xyz="0 0 0.03256" rpy="0 -1.5708 0" />
  <xacro:mesh_link name="joint4" mesh="joint4" xyz="0 0 0.03056" rpy="0 -1.5708 0" />
  <xacro:mesh_link name="joint5" mesh="joint5" xyz="0 0 -0.03356" rpy="-1.5708 0 0" />
  <xacro:mesh_link name="joint6" mesh="joint6" xyz="0 0 -0.038" rpy="0 0 0" />
  <xacro:mesh_link name="joint6_flange" mesh="joint7" xyz="0 0 -0.012" rpy="0 0 0" />

  <joint name="g_base_to_joint1" type="fixed">
    <parent link="g_base" />
    <child link="joint1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <xacro:arm_joint name="joint2_to_joint1" parent="joint1" child="joint2" xyz="0 0 0.13156" rpy="0 0 0" />
  <xacro:arm_joint name="joint3_to_joint2" parent="joint2" child="joint3" xyz="0 0 0" rpy="0 1.5708 -1.5708" />
  <xacro:arm_joint name="joint4_to_joint3" parent="joint3" child="joint4" xyz="-0.1104 0 0" rpy="0 0 0" />
  <xacro:arm_joint name="joint5_to_joint4" parent="joint4" child="joint5" xyz="-0.096 0 0.06462" rpy="0 0 -1.5708" />
  <xacro:arm_joint name="joint6_to_joint5" parent="joint5" child="joint6" xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0" />
  <xacro:arm_joint name="joint6output_to_joint6" parent="joint6" child="joint6_flange" xyz="0 0.0456 0" rpy="-1.5708 0.7854 0" />

</robot>
