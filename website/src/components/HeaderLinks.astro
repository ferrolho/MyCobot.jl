---
// Replaces Starlight's SocialIcons in the header: the two parts of the site (Docs, Control),
// then the default social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const onControl = Astro.url.pathname.startsWith(`${base}/control`);
---

<nav class="site-nav" aria-label="Site">
  <a href={`${base}/`} aria-current={onControl ? undefined : 'page'}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h5.5A3.5 3.5 0 0 1 12 8.5V20a2.5 2.5 0 0 0-2.5-2.5H3z" /><path d="M21 5h-5.5A3.5 3.5 0 0 0 12 8.5V20a2.5 2.5 0 0 1 2.5-2.5H21z" /></svg>
    Docs
  </a>
  <a href={`${base}/control/`} aria-current={onControl ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="15" width="18" height="6" rx="2" /><path d="M12 15V9.5" /><circle cx="12" cy="6.5" r="3" /><path d="M7 15v-1.5" /></svg>
    Control
  </a>
</nav>
<Default />

<style>
  .site-nav {
    display: flex;
    gap: 1rem;
    margin-inline-end: 0.5rem;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-weight: 600;
  }
  .site-nav svg {
    width: 1.15em;
    height: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .site-nav a:hover {
    color: var(--sl-color-white);
  }
  .site-nav a[aria-current='page'] {
    color: var(--sl-color-text-accent);
  }
</style>
