---
// FT232R to base wiring.
---
<svg class="diagram" viewBox="0 0 640 200" role="img" aria-label="Wiring: FT232R TXD to base pin 14, FT232R RXD to base pin 13, FT232R GND to base GND. The base bridges pins 13 and 14 to the servo bus.">
  <rect class="box" x="10" y="20" width="170" height="160" rx="10" />
  <text x="95" y="50" text-anchor="middle" class="title">FT232R</text>
  <text x="95" y="72" text-anchor="middle" class="small">USB to the laptop</text>
  {['TXD', 'RXD', 'GND'].map((p, i) => (
    <g><circle cx="180" cy={105 + i * 30} r="6" class="accent" /><text x="165" y={110 + i * 30} text-anchor="end">{p}</text></g>
  ))}
  <rect class="box" x="380" y="20" width="170" height="160" rx="10" />
  <text x="465" y="50" text-anchor="middle" class="title">Base</text>
  <text x="465" y="72" text-anchor="middle" class="small">header</text>
  {['pin 14', 'pin 13', 'GND'].map((p, i) => (
    <g><circle cx="380" cy={105 + i * 30} r="6" class="accent" /><text x="395" y={110 + i * 30}>{p}</text></g>
  ))}
  <line class="bus" x1="186" y1="105" x2="374" y2="105" />
  <line class="bus" x1="186" y1="135" x2="374" y2="135" />
  <line class="line" x1="186" y1="165" x2="374" y2="165" />
  <line class="bus" x1="550" y1="120" x2="630" y2="120" />
  <text x="590" y="110" text-anchor="middle" class="small">servos</text>
</svg>
