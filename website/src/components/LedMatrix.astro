---
// A picture of the ATOM's 5×5 LED matrix.
//   fill:    colour of every pixel (or null = off)
//   rows:    five colours, one per row from the top (overrides fill; null = off)
//   animate: { type: 'spiral' | 'flash' | 'flicker' | 'pulse' | 'blink', row?: number, color?: string }
//            spiral:   pixels light one at a time from the centre out to the top-left corner (the playing
//                      progress). Draws `color` over fill/rows; each pixel lights halfway through its 1/25
//                      of the run, the run is the first 80% of the loop, then all stay lit until 96%
//            flash:    the row flashes briefly
//            flicker:  the row flickers (bus activity)
//            pulse:    the whole matrix pulses
//            blink:    every lit pixel turns on and off, once a second (the frame stays)
//   label:   accessible description (also shown as the caption)
interface Props {
  fill?: string | null;
  rows?: (string | null)[];
  animate?: { type: 'spiral' | 'flash' | 'flicker' | 'pulse' | 'blink'; row?: number; color?: string };
  label: string;
  caption?: string;
  size?: number;
}
const { fill = null, rows, animate, label, caption, size = 112 } = Astro.props;
const OFF = '#26282c';
const colorOf = (r: number) => (rows ? rows[r] ?? null : fill);
// Pixel indices (row × 5 + column) in the order they light, as SPIRAL in the controller firmware.
const SPIRAL = [12, 7, 8, 13, 18, 17, 16, 11, 6, 1, 2, 3, 4, 9, 14, 19, 24, 23, 22, 21, 20, 15, 10, 5, 0];
const order = animate?.type === 'spiral' ? SPIRAL : undefined;
const step = (k: number) => (80 * (k + 0.5)) / order!.length;   // % of the loop where step k lights
const pixels = [...Array(25).keys()].map((i) => {
  const r = Math.floor(i / 5), c = i % 5;
  const k = order ? order.indexOf(i) : -1;
  const animated = order ? k >= 0 : animate && animate.type !== 'pulse' && animate.type !== 'blink' && animate.row === r;
  return { r, c, color: animated && !order ? null : colorOf(r), animated, k };
});
const seqCss = order
  ? order.map((_, k) => {
      const on = step(k).toFixed(2);
      return `@keyframes ${animate!.type}-${k} { 0%, ${on}% { opacity: 0; } ${(+on + 0.01).toFixed(2)}%, 95.9% { opacity: 1; } 96%, 100% { opacity: 0; } }
.anim-${animate!.type}-${k} { animation: ${animate!.type}-${k} 8s infinite; }
@media (prefers-reduced-motion: reduce) { .anim-${animate!.type}-${k} { animation: none; opacity: ${step(k) < 48 ? 1 : 0}; } }`;
    }).join('\n')
  : '';
const pitch = 20, radius = 7.2;
---
<figure class="led-figure" style={`width:${size}px`}>
  <svg viewBox="0 0 110 110" role="img" aria-label={label} class={animate?.type === 'pulse' ? 'pulse' : ''}>
    <rect x="0" y="0" width="110" height="110" rx="12" class="frame" />
    {pixels.map((p) => (
      <g>
        <circle cx={15 + p.c * pitch} cy={15 + p.r * pitch} r={radius} fill={OFF} />
        {p.color && (
          <circle cx={15 + p.c * pitch} cy={15 + p.r * pitch} r={radius} fill={p.color} class={animate?.type === 'blink' ? 'lit anim-blink' : 'lit'} style={`--glow:${p.color}`} />
        )}
        {p.animated && (
          <circle
            cx={15 + p.c * pitch} cy={15 + p.r * pitch} r={radius}
            fill={animate!.color ?? '#ffffff'}
            class={`lit anim-${animate!.type}${order ? ` anim-${animate!.type}-${p.k}` : ''}`}
            style={`--glow:${animate!.color ?? '#ffffff'}; --i:${p.c}`}
          />
        )}
      </g>
    ))}
  </svg>
  <figcaption>{caption ?? label}</figcaption>
  {seqCss && <style is:inline set:html={seqCss} />}
</figure>

<style>
  .led-figure { display: inline-block; margin: 0.5rem 1rem 0.5rem 0; vertical-align: top; text-align: center; }
  .led-figure svg { width: 100%; height: auto; }
  .led-figure figcaption { font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); margin-top: 0.25rem; line-height: 1.3; }
  .frame { fill: #111214; stroke: #3a3d42; stroke-width: 2; }
  .lit { filter: drop-shadow(0 0 3px var(--glow)); }
  .anim-spiral { opacity: 0; }
  .anim-flash { animation: flash 1.6s infinite; }
  @keyframes flash { 0%, 18% { opacity: 1; } 19%, 100% { opacity: 0; } }
  .anim-flicker { animation: flicker 0.9s infinite steps(1); }
  @keyframes flicker { 0% { opacity: 1; } 30% { opacity: 0.2; } 45% { opacity: 1; } 70% { opacity: 0.4; } 85% { opacity: 1; } }
  .pulse { animation: pulse 2s infinite ease-in-out; }
  .anim-blink { animation: blink 1s infinite steps(1); }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
  @media (prefers-reduced-motion: reduce) {
    .anim-flash, .anim-flicker, .pulse, .anim-blink { animation: none; }
  }
</style>
