---
// The Control page: the browser talks straight to the ATOM over a WebSocket (docs: comms/websocket-api).
// Layout (wide screens): a bar with the connection, the control lease and STOP; then the camera,
// the 3D view and the joint faders; then six plots. It fits one screen from 1440×900 up.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage
  frontmatter={{
    title: 'Control',
    description: 'Watch and move your myCobot 280 from the browser. The page connects straight to the ATOM over WiFi.',
    template: 'splash',
    tableOfContents: false,
    pagefind: false,
    editUrl: false,
    lastUpdated: false,
    prev: false,
    next: false,
  }}
>
  <div class="ctl not-content" id="ctl" data-control="none">
    <section class="bar" aria-label="Connection and control">
      <form id="connect-form" class="connect-form">
        <label for="addr" class="sr-only">Robot address</label>
        <input id="addr" list="addr-history" placeholder="Robot: 192.168.1.107 or mycobot.local" autocomplete="off" spellcheck="false" />
        <datalist id="addr-history"></datalist>
        <button id="connect" type="submit" class="btn primary">Connect</button>
      </form>
      <div class="status">
        <span id="link-status" class="pill" data-status="disconnected"><span class="dot" aria-hidden="true"></span><span class="label">Disconnected</span></span>
        <span id="target" class="target" data-target="" role="status"></span>
        <span id="robot-state" class="pill quiet"></span>
      </div>
      <div class="lease" role="group" aria-label="Control lease">
        <p id="control-text" class="control-text"></p>
        <button id="control-btn" type="button" class="btn">Take control</button>
        <button id="takeover-btn" type="button" class="btn" hidden>Take over</button>
      </div>
      <div class="safety">
        <button id="hold-btn" type="button" class="btn">Hold</button>
        <button id="stop-btn" type="button" class="btn danger stop" title="Stop the robot (Esc)">Stop <kbd>Esc</kbd></button>
      </div>
    </section>
    <p id="hint" class="hint" hidden></p>

    <div class="grid">
      <section class="card arm" aria-labelledby="arm-title">
        <header class="card-head">
          <h2 id="arm-title">3D view</h2>
          <button id="arm-reset" type="button" class="btn small-btn">Reset view</button>
        </header>
        <div id="arm-view" class="arm-view" data-urdf={`${base}/robot/mycobot_280_arduino.urdf`} role="img" aria-label="3D model of the arm in the measured pose. A see-through arm shows the goal pose."></div>
        <p class="muted small">Solid: measured pose. See-through blue: goal. Drag to turn, scroll to zoom.</p>
      </section>

      <section class="card joints" aria-labelledby="joints-title">
        <header class="card-head">
          <h2 id="joints-title">Joints</h2>
          <!-- One message line: the hint, or why the controls are off, or that Live mode is on. -->
          <p class="joints-hint muted small">Drag a blue goal marker or type a goal, then <strong>Move</strong>. Hold ▼ or ▲ to jog. White line: measured angle.</p>
          <div id="watch-banner" class="watch-banner" role="status">
            <span id="watch-text">Not connected.</span>
            <button id="watch-btn" type="button" class="btn small-btn primary" hidden>Take control</button>
          </div>
          <p id="live-banner" class="live-banner" role="status"><strong>Live</strong>: the arm follows the goals at once. <kbd>Esc</kbd> stops.</p>
        </header>
        <div id="strips" class="strips"></div>
        <template id="strip">
          <div class="strip">
            <div class="s-head"><i class="key" aria-hidden="true"></i><span class="j-name"></span></div>
            <div class="j-angle num"></div>
            <div class="fader">
              <div class="f-track" aria-hidden="true">
                <span class="f-lim f-top num"></span>
                <span class="f-zero"></span>
                <span class="f-fill"></span>
                <span class="f-pos"></span>
                <span class="f-lim f-bot num"></span>
              </div>
              <input type="range" class="goal-input" step="0.1" />
            </div>
            <label class="goal-field"><span class="sr-only">Goal (°)</span><input type="number" class="goal-num num" step="0.1" inputmode="decimal" /></label>
            <div class="jogs">
              <button type="button" class="btn jog needs-control not-live" data-dir="-1">▼</button>
              <button type="button" class="btn jog needs-control not-live" data-dir="1">▲</button>
            </div>
            <div class="j-meta muted num"><span class="j-temp"></span><span class="j-volt"></span></div>
          </div>
        </template>
        <footer class="joints-foot">
          <div class="field">
            <label class="live-switch"><input id="live" type="checkbox" /> Live</label>
            <label for="jog-speed" title="Move, Go to zero and Live mode: up to this speed. The jog buttons: up to 30 °/s.">Speed</label>
            <input id="jog-speed" type="range" min="5" max="90" step="5" value="45" />
            <output id="jog-speed-value" for="jog-speed" class="num">45 °/s</output>
          </div>
          <div class="btn-row">
            <button id="goal-current" type="button" class="btn" title="Set the goals to the pose that the robot holds">Use current pose</button>
            <button id="zero-btn" type="button" class="btn needs-control not-live">Go to zero</button>
            <button id="goal-move" type="button" class="btn primary needs-control not-live">Move</button>
          </div>
        </footer>
      </section>

      <section id="camera-card" class="card camera" aria-labelledby="camera-title" hidden data-running="false">
        <header class="card-head">
          <h2 id="camera-title">Camera</h2>
          <div class="btn-row">
            <label class="sr-only" for="camera-source">Camera source</label>
            <select id="camera-source"></select>
            <label id="camera-overlay-switch" class="overlay-switch" hidden title="Draw the robot model through the calibrated camera model. If the drawing sits on the robot, the calibration is correct.">
              <input id="camera-overlay" type="checkbox" role="switch" /> Overlay
            </label>
            <button id="camera-start" type="button" class="btn small-btn">Start</button>
          </div>
        </header>
        <div class="camera-view">
          <img id="camera-img" alt="Camera image of the robot" hidden />
          <video id="camera-video" autoplay muted playsinline hidden></video>
        </div>
        <p id="camera-note" class="muted small"></p>
      </section>

      <section class="card plots" aria-labelledby="plots-title">
        <h2 id="plots-title" class="sr-only">Plots, last 20 s</h2>
        <div id="plot-grid" class="plot-grid"></div>
        <template id="plot">
          <figure class="plot">
            <figcaption><span class="p-title"></span><span class="p-legend num"></span></figcaption>
            <div class="p-area"></div>
          </figure>
        </template>
      </section>
    </div>

    <footer class="foot muted small">
      <span class="foot-left"><span id="fw"></span><span id="log" class="log" aria-live="off"></span></span>
      <span class="foot-note" title="Needs our controller firmware 4.2 or later."><a href={`${base}/software/control-page/`}>Help</a> · <a href={`${base}/comms/websocket-api/`}>WebSocket API</a> · <a href={`${base}/start/safety/`}>Safety</a></span>
    </footer>
    <div id="toasts" class="toasts" aria-live="polite"></div>
  </div>
</StarlightPage>

<script>
  import { start } from '../control/app';
  import { setupCamera } from '../control/camera';
  setupCamera(start());
</script>

<style is:global>
  /* Joint colours: the validated categorical palette, slots 1-7 (J1-J7; J7 is the gripper), the same
     in the faders and the plots. The IMU plots use slots 1-3 for x, y, z. Starlight's default theme is dark;
     data-theme="light" switches. */
  .ctl {
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
    --series-4: #c98500;
    --series-5: #d55181;
    --series-6: #008300;
    --series-7: #9085e9;
    --grid: #2c2c2a;
    --axis: #898781;
    --good: #0ca30c;
    --warning: #fab219;
    --critical: #d03b3b;
    --card: var(--sl-color-gray-6);
    --well: var(--sl-color-black);
    --line: var(--sl-color-gray-5);
    --goal: #3987e5;
  }
  :root[data-theme='light'] .ctl {
    --series-1: #2a78d6;
    --series-2: #eb6834;
    --series-3: #1baf7a;
    --series-4: #eda100;
    --series-5: #e87ba4;
    --series-6: #008300;
    --series-7: #4a3aa7;
    --grid: #e1e0d9;
    /* Starlight's light theme swaps the scale: --sl-color-black is the page (white), --sl-color-white the text. */
    --card: var(--sl-color-black);
    --well: var(--sl-color-gray-7);
    --line: var(--sl-color-gray-5);
    --goal: #2a78d6;
  }

  /* This page is an application: no page title block, a full-width frame, little padding. */
  :root:has(#ctl) { --sl-content-width: 200rem; }
  :root:has(#ctl) main > .content-panel:first-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); padding: 0; border: 0; }
  :root:has(#ctl) main > .content-panel { padding: 0.75rem clamp(0.75rem, 1.5vw, 1.25rem); border: 0; }
  :root:has(#ctl) main > .content-panel .sl-container { max-width: none; }
  :root:has(#ctl) main { padding-bottom: 0; }
  :root:has(#ctl) main .sl-container > footer { display: none; }

  .ctl { display: flex; flex-direction: column; gap: 0.6rem; }
  .ctl [hidden] { display: none !important; }
  .ctl h2 { font-size: 0.95rem; margin: 0; letter-spacing: 0.01em; }
  .ctl p { margin: 0; }
  .ctl .muted { color: var(--sl-color-gray-3); }
  .ctl .small { font-size: 0.8rem; }
  .ctl .num { font-variant-numeric: tabular-nums; }
  .ctl .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ctl .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    padding: 0.6rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    min-height: 0;
  }
  .ctl .card-head { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: center; justify-content: space-between; }

  /* --- Bar: connection | status | control lease | STOP --- */
  .ctl .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.5rem 0.6rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
  }
  .ctl[data-target='real'] .bar { border-color: var(--good); box-shadow: inset 4px 0 0 var(--good); }
  .ctl .connect-form { display: flex; gap: 0.4rem; align-items: center; flex: 0 1 21rem; min-width: 14rem; }
  .ctl input:not([type]),
  .ctl input[type='text'] {
    flex: 1 1 12rem;
    min-width: 0;
    font: inherit;
    padding: 0.4rem 0.6rem;
    border-radius: 0.45rem;
    border: 1px solid var(--sl-color-gray-4);
    background: var(--well);
    color: var(--sl-color-white);
  }
  .ctl .status { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.9rem; flex: 1 1 auto; min-width: 0; }
  .ctl .pill { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; white-space: nowrap; }
  .ctl .pill.quiet { font-weight: 400; }
  .ctl .pill.quiet:empty, .ctl .target:empty { display: none; }
  .ctl .target { font-weight: 700; padding: 0.1rem 0.6rem; border-radius: 999px; border: 2px solid; white-space: nowrap; font-size: 0.9rem; }
  .ctl .target[data-target='real'] { color: var(--good); border-color: var(--good); }
  .ctl .target[data-target='sim'] { color: var(--sl-color-gray-2); border-color: var(--sl-color-gray-4); border-style: dashed; }
  .ctl .dot { width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--axis); }
  .ctl [data-status='connected'] .dot { background: var(--good); }
  .ctl [data-status='connecting'] .dot { background: var(--warning); }
  .ctl #robot-state[data-state='4'] { color: var(--critical); font-weight: 600; }

  .ctl .lease {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.2rem 0.25rem 0.2rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    background: var(--well);
  }
  .ctl .control-text { font-weight: 600; font-size: 0.85rem; max-width: 14rem; line-height: 1.25; }
  .ctl[data-control='mine'] .lease { border-color: var(--good); box-shadow: inset 4px 0 0 var(--good); }
  .ctl[data-control='other'] .lease { border-color: var(--warning); box-shadow: inset 4px 0 0 var(--warning); }
  .ctl .safety { display: flex; gap: 0.5rem; align-items: center; margin-inline-start: auto; }
  .ctl .btn.stop { font-size: 1.05rem; padding: 0.5rem 1.1rem; min-width: 7.5rem; letter-spacing: 0.02em; }
  .ctl .btn.stop kbd { font: 600 0.7rem var(--sl-font-mono); padding: 0.05rem 0.3rem; margin-inline-start: 0.35rem; border-radius: 0.25rem; border: 1px solid rgb(255 255 255 / 0.6); vertical-align: 0.1rem; }

  .ctl .hint { padding: 0.45rem 0.75rem; border-radius: 0.5rem; border-inline-start: 4px solid var(--sl-color-accent); background: var(--card); font-size: 0.9rem; }
  .ctl .hint[data-kind='warning'] { border-color: var(--warning); }

  /* --- Buttons and inputs --- */
  .ctl .btn {
    font: inherit;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 0.45rem;
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
    cursor: pointer;
    touch-action: none;
    user-select: none;
    white-space: nowrap;
  }
  :root[data-theme='light'] .ctl .btn:not(.primary):not(.danger) { background: var(--sl-color-gray-7, #f6f6f6); }
  .ctl .btn:hover:not(:disabled) { border-color: var(--sl-color-accent); }
  .ctl .btn:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .ctl .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .ctl .btn.primary { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: var(--sl-color-black); }
  .ctl .btn.danger { background: var(--critical); border-color: var(--critical); color: #fff; }
  .ctl .btn.small-btn { font-size: 0.8rem; padding: 0.2rem 0.6rem; }
  .ctl .btn-row { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .ctl select { font: inherit; font-size: 0.8rem; padding: 0.2rem 0.4rem; border-radius: 0.45rem; border: 1px solid var(--sl-color-gray-4); background: var(--well); color: var(--sl-color-white); max-width: 13rem; }
  .ctl input[type='range'] { accent-color: var(--sl-color-accent); }

  /* --- Main grid. Wide screens: one screen, no page scroll. --- */
  .ctl .grid {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr) minmax(0, 1.55fr);
    grid-template-rows: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-areas: 'camera arm joints' 'plots plots plots';
  }
  .ctl .grid:has(#camera-card[hidden]) { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.6fr); grid-template-areas: 'arm joints' 'plots plots'; }
  .ctl .arm { grid-area: arm; }
  .ctl .joints { grid-area: joints; }
  .ctl .camera { grid-area: camera; }
  .ctl .plots { grid-area: plots; }
  @media (min-width: 75rem) and (min-height: 40rem) {
    .ctl { height: calc(100dvh - var(--sl-nav-height, 4rem) - 1.5rem); }
    .ctl .grid { flex: 1 1 auto; min-height: 0; }
  }
  /* --- 3D view and camera --- */
  .ctl .arm-view { flex: 1 1 auto; min-height: 10rem; border-radius: 0.45rem; background: var(--well); overflow: hidden; position: relative; touch-action: none; }
  .ctl .arm-view:not([data-loaded])::after { content: 'Loading the 3D model…'; position: absolute; inset: 0; display: grid; place-items: center; color: var(--sl-color-gray-3); }
  .ctl .arm-view[data-loaded='error']::after { content: 'The 3D model did not load.'; position: absolute; inset: 0; display: grid; place-items: center; color: var(--sl-color-gray-3); }
  .ctl .camera-view { flex: 1 1 auto; min-height: 8rem; border-radius: 0.45rem; background: #000; overflow: hidden; display: grid; place-items: center; position: relative; }
  .ctl .camera[data-running='false'] .camera-view::after { content: 'Camera off'; color: var(--sl-color-gray-3); }
  .ctl .camera-view img, .ctl .camera-view video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  /* Camera overlay: exactly over the image (camera_overlay.ts sets its box), the legend at the bottom left. */
  .ctl .camera-overlay { position: absolute; pointer-events: none; }
  .ctl .camera-overlay canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ctl .overlay-legend {
    position: absolute; left: 0.3rem; bottom: 0.3rem; max-width: calc(100% - 0.6rem);
    display: flex; flex-wrap: wrap; gap: 0.1rem 0.6rem; padding: 0.15rem 0.45rem; border-radius: 0.3rem;
    background: rgb(0 0 0 / 0.6); color: #fff; font-size: 0.7rem; line-height: 1.35;
  }
  .ctl .overlay-legend span { white-space: nowrap; }
  .ctl .overlay-legend i { display: inline-block; width: 0.7rem; height: 0.2rem; border-radius: 1px; margin-inline-end: 0.3rem; vertical-align: 0.2rem; }
  .ctl .overlay-legend .overlay-date { color: #ddd; }
  .ctl .overlay-legend .overlay-warn { color: var(--warning); font-weight: 600; white-space: normal; }
  .ctl .overlay-switch { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; font-weight: 600; padding: 0.1rem 0.45rem; border-radius: 0.4rem; border: 1px solid var(--sl-color-gray-4); cursor: pointer; }
  .ctl .overlay-switch input { margin: 0; accent-color: var(--sl-color-accent); }
  .ctl .overlay-switch:has(input:checked) { border-color: var(--sl-color-accent); }

  /* --- Joint strips: one vertical fader per joint --- */
  .ctl .strips { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.4rem; }
  .ctl .strips:has(.strip[data-joint='6']:not([hidden])) { grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .ctl .strip[hidden] { display: none; }

  .ctl .strip {
    display: grid;
    grid-template-rows: auto auto minmax(4rem, 1fr) auto auto auto;
    justify-items: center;
    gap: 0.25rem;
    min-height: 0;
    padding: 0.4rem 0.25rem 0.35rem;
    border-radius: 0.45rem;
    background: var(--well);
    border: 1px solid transparent;
  }
  .ctl .strip.servo-fault { border-color: var(--critical); }
  .ctl .strip.servo-fault .j-name::after { content: ' ⚠'; color: var(--critical); }
  .ctl .s-head { display: flex; align-items: center; gap: 0.35rem; font-weight: 700; }
  .ctl .key { display: inline-block; width: 0.9rem; height: 0.2rem; border-radius: 2px; background: var(--key); }
  .ctl .j-angle { font-size: clamp(0.95rem, 1.2vw, 1.25rem); font-weight: 600; text-align: center; }
  .ctl .j-pct { display: block; font-size: 0.7rem; font-weight: 400; white-space: nowrap; }
  .ctl .jogs { display: flex; gap: 0.25rem; width: 100%; max-width: 6rem; }
  .ctl .jog { flex: 1; min-width: 0; height: 1.9rem; padding: 0; font-size: 0.85rem; line-height: 1; }
  .ctl .fader { position: relative; width: 100%; max-width: 4.5rem; min-height: 0; height: 100%; }
  .ctl .f-track { position: absolute; inset: 0.6rem 0; margin-inline: auto; width: 0.5rem; border-radius: 0.25rem; background: var(--sl-color-gray-5); }
  .ctl .f-zero { position: absolute; left: -0.45rem; right: -0.45rem; top: 50%; height: 1px; background: var(--axis); }
  .ctl .f-fill { position: absolute; left: 0; right: 0; border-radius: 0.25rem; background: var(--key); opacity: 0.85; top: 50%; height: 0; }
  .ctl .f-pos { position: absolute; left: -0.6rem; right: -0.6rem; height: 3px; margin-top: -1.5px; top: 50%; border-radius: 2px; background: var(--sl-color-white); box-shadow: 0 0 0 1px var(--well); }
  .ctl .f-lim { position: absolute; left: 0.85rem; font-size: 0.65rem; color: var(--sl-color-gray-3); white-space: nowrap; }
  .ctl .f-top { top: -0.55rem; }
  .ctl .f-bot { bottom: -0.55rem; }
  /* The goal slider sits over the track: transparent track, a ring thumb. Vertical: min at the bottom. */
  .ctl .goal-input {
    position: absolute;
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    writing-mode: vertical-lr;
    direction: rtl;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    cursor: ns-resize;
  }
  .ctl .goal-input:disabled { cursor: default; }
  .ctl .goal-input::-webkit-slider-runnable-track { background: transparent; }
  .ctl .goal-input::-moz-range-track { background: transparent; }
  .ctl .goal-input::-webkit-slider-thumb { -webkit-appearance: none; width: 1.6rem; height: 0.95rem; border-radius: 0.3rem; background: color-mix(in srgb, var(--goal) 25%, transparent); border: 2.5px solid var(--goal); box-shadow: 0 0 0 1px var(--well); }
  .ctl .goal-input::-moz-range-thumb { width: 1.6rem; height: 0.95rem; border-radius: 0.3rem; background: color-mix(in srgb, var(--goal) 25%, transparent); border: 2.5px solid var(--goal); box-shadow: 0 0 0 1px var(--well); }
  .ctl .goal-input:disabled::-webkit-slider-thumb { border-color: var(--sl-color-gray-4); }
  .ctl .goal-input:disabled::-moz-range-thumb { border-color: var(--sl-color-gray-4); }
  .ctl .goal-input:focus-visible { outline: none; }
  .ctl .goal-input:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 3px var(--sl-color-accent-low); }
  /* Typed goal: a small number field under the fader. Blue while the goal differs from the angle. */
  .ctl .goal-field { width: 100%; max-width: 5.2rem; }
  .ctl .goal-num {
    width: 100%;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
    padding: 0.15rem 0.2rem;
    border-radius: 0.35rem;
    border: 1px solid var(--goal);
    background: var(--card);
    color: var(--goal);
    -moz-appearance: textfield;
  }
  .ctl .goal-num::-webkit-inner-spin-button, .ctl .goal-num::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
