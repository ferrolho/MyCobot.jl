# systemd user unit for the lab web service (site + camera) on the Raspberry Pi.
# Install:  mkdir -p ~/.config/systemd/user && cp tools/pi/lab-service.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now lab-service
#           loginctl enable-linger $USER     # start at boot, without a login
# It runs from the checkout ~/myCobot/lab-services (main). Docs: software/control-page.md.
[Unit]
Description=myCobot lab web service (site and camera, Tailscale only)
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/myCobot/lab-services
# Binds the Tailscale address only. At boot Tailscale can come up later: the service retries.
ExecStart=/usr/bin/python3 tools/pi/lab_service.py --host 100.69.15.110 --port 8280
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
