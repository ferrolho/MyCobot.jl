# systemd user unit for the lab web service (site, camera, relay to the ATOM) on the Raspberry Pi.
# Install:  mkdir -p ~/.config/systemd/user && cp tools/pi/lab-service.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now lab-service
#           loginctl enable-linger $USER     # start at boot, without a login
# It runs from the checkout ~/myCobot/lab-services (main). Docs: software/control-page.md.
[Unit]
Description=myCobot lab web service (site, camera and ATOM relay)
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/myCobot/lab-services
# Serves loopback and Tailscale clients, and the home-network computers in LAB_ALLOW from
# ~/.config/lab-service.env, one "--allow ADDRESS" each: LAB_ALLOW=--allow 192.168.1.50
EnvironmentFile=-%h/.config/lab-service.env
ExecStart=/usr/bin/python3 tools/pi/lab_service.py --host 0.0.0.0 --port 8280 $LAB_ALLOW
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
